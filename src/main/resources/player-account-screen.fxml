<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.paint.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.PlayerAccountController">
  <top>
    <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" BorderPane.alignment="CENTER">
      <Label fx:id="playerGreeting">
        <font>
          <Font size="32.0" />
        </font>
      </Label>
      <Region HBox.hgrow="ALWAYS" />
      <ImageView fx:id="characterImage" fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true">
        <Image url="@images/GreenGuy.png" preserveRatio="true">
        </Image>
      </ImageView>
    </HBox>
  </top>
  <padding>
    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
  </padding>
  <right>
    <VBox alignment="TOP_CENTER" prefHeight="200.0" prefWidth="100.0" spacing="5.0" BorderPane.alignment="CENTER">
      <Label text="Health">
        <font>
          <Font size="18.0" />
        </font>
      </Label>
      <ProgressBar fx:id="healthProgressBar" maxWidth="200.0" minWidth="-Infinity" prefWidth="150.0">
        <effect>
          <Lighting>
            <bumpInput>
              <Shadow />
            </bumpInput>
            <light>
              <Light.Distant>
                <color>
                  <Color green="1.0" blue="0.21666666865348816" />
                </color>
              </Light.Distant>
            </light>
          </Lighting>
        </effect>
      </ProgressBar>
      <Label text="Level">
        <font>
          <Font size="18.0" />
        </font>
        <VBox.margin>
          <Insets top="10.0" />
        </VBox.margin>
      </Label>
      <Label text="0">
        <font>
          <Font size="14.0" />
        </font>
      </Label>
    </VBox>
  </right>
  <left>
    <VBox alignment="CENTER" prefHeight="320.0" prefWidth="149.0" spacing="20.0" BorderPane.alignment="CENTER">
      <children>
        <Button onAction="#goToBattleScene" text="Battle!" />
        <Button onAction="#logout" text="Logout">
          <VBox.margin>
            <Insets top="10.0" />
          </VBox.margin>
        </Button>
        <Button onAction="#updatePassword" text="Update Password">
          <VBox.margin>
            <Insets top="10.0" />
          </VBox.margin>
        </Button>
        <PasswordField fx:id="passwordField" managed="false" promptText="Enter new password" visible="false" />
        <TextField fx:id="visiblePassword" managed="false" promptText="Enter new password" visible="false" />
        <CheckBox managed="false" text="Show password" visible="false" />
        <PasswordField fx:id="confirmPasswordField" managed="false" promptText="Confirm password" visible="false" />
        <TextField fx:id="visibleConfirmPassword" managed="false" promptText="Confirm password" visible="false" />
        <Button onAction="#deleteAccount" text="Delete Account">
          <VBox.margin>
            <Insets top="10.0" />
          </VBox.margin>
        </Button>
      </children>
    </VBox>
  </left>
   <bottom>
      <HBox prefHeight="100.0" prefWidth="200.0" BorderPane.alignment="CENTER" />
   </bottom>
</BorderPane>
