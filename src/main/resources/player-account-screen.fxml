<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.paint.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.PlayerAccountController">
   <top>
      <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" BorderPane.alignment="CENTER">
            <Label fx:id="playerGreeting">
               <font>
                  <Font size="32.0" />
               </font>
            </Label>
        <Region HBox.hgrow="ALWAYS" />
            <ImageView fx:id="characterImage" fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true" />
      </HBox>
   </top>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <right>
      <VBox alignment="TOP_CENTER" prefHeight="200.0" prefWidth="100.0" spacing="10.0" BorderPane.alignment="CENTER">
            <Label text="Health">
               <font>
                  <Font size="18.0" />
               </font></Label>
            <ProgressBar fx:id="healthProgressBar" maxWidth="200.0" minWidth="-Infinity" prefWidth="150.0">
            <effect>
               <Lighting>
                  <bumpInput>
                     <Shadow />
                  </bumpInput>
                  <light>
                     <Light.Distant>
                        <color>
                           <Color green="1.0" blue="0.21666666865348816" />
                        </color>
                     </Light.Distant>
                  </light>
               </Lighting>
            </effect></ProgressBar>
      </VBox>
   </right>
   <bottom>
      <GridPane BorderPane.alignment="CENTER">
        <columnConstraints>
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
        </rowConstraints>
      </GridPane>
   </bottom>
   <left>
      <VBox alignment="CENTER" prefHeight="320.0" prefWidth="149.0" spacing="50.0" BorderPane.alignment="CENTER">
         <children>
            <Button onAction="#goToBattleScene" text="Battle!" />
            <Button onAction="#logout" text="Logout" />
            <Button onAction="#updatePassword" text="Update Password" />
            <PasswordField fx:id="passwordField" promptText="Enter new password" />
            <PasswordField fx:id="confirmPasswordField" promptText="Confirm password" />
            <Button onAction="#deleteAccount" text="Delete Account" />
         </children>
      </VBox>
   </left>
</BorderPane>
