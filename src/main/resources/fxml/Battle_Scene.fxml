<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.BattleController">
   <children>
      <Button fx:id="runAway" layoutX="250.0" layoutY="328.0" mnemonicParsing="false" onAction="#handleRunAway" prefHeight="30.0" prefWidth="92.0" text="Run Away" />
      <Button fx:id="battle" layoutX="48.0" layoutY="282.0" mnemonicParsing="false" onAction="#handleFight" prefHeight="30.0" prefWidth="71.0" text="Fight!" />
      <Button layoutX="140.0" layoutY="300.0" mnemonicParsing="false" onAction="#handleResetStats" text="Reset Stats" />
      <AnchorPane prefHeight="121.0" prefWidth="117.0">
         <children>
            <VBox layoutY="9.0" prefHeight="104.0" prefWidth="107.0" style="-fx-background-color: Orange;" AnchorPane.rightAnchor="455.2" AnchorPane.topAnchor="9.0">
               <children>
                  <Label fx:id="winsLabel" prefHeight="30.0" prefWidth="92.0" text="W: 0" />
                  <Label fx:id="lossesLabel" prefHeight="27.0" prefWidth="103.0" text="L: 0" />
                  <Label fx:id="fleesLabel" prefHeight="30.0" prefWidth="99.0" text="Fled: 0" />
                  <Label fx:id="turnLabel" layoutX="500.0" layoutY="20.0" text="turn: 1" />
                  <Label fx:id="playerHealthLabel" layoutX="40.0" layoutY="230.0" text="Player HP: 100" />
                  <Label fx:id="oppHealthLabel" layoutX="430.0" layoutY="230.0" text="Opponent HP: 100" />
               </children>
            </VBox>
         </children>
      </AnchorPane>

  </children>
</AnchorPane>
